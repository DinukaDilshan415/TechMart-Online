<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="TechMartPU" transaction-type="JTA">
        <jta-data-source>jdbc/TechMartDS</jta-data-source>

        <class>me.dinuka.tmo.entity.City</class>
        <class>me.dinuka.tmo.entity.User</class>
        <class>me.dinuka.tmo.entity.Status</class>
        <class>me.dinuka.tmo.entity.AdminRole</class>
        <class>me.dinuka.tmo.entity.Admin</class>

        <properties>
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQL8Dialect"/>

            <property name="hibernate.transaction.jta.platform" value="org.hibernate.engine.transaction.jta.platform.internal.JakartaJtaPlatform"/>

            <property name="hibernate.hbm2ddl.auto" value="update"/>

            <property name="hibernate.jdbc.batch_size" value="30"/>
            <property name="hibernate.order_inserts" value="true"/>
            <property name="hibernate.order_updates" value="true"/>

            <property name="hibernate.show_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>